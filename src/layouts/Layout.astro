---
// Layout principal: metadatos por idioma, SEO, accesibilidad y sistema de diseno.
import "@fontsource-variable/albert-sans";
import "@fontsource-variable/alumni-sans";
import "@fontsource-variable/jetbrains-mono";

import type { Locale } from "../util/i18n";
import { OG_IMAGE, SITE, SITE_URL, pathForLocale } from "../util/site";

interface Props {
  title: string;
  description: string;
  /** Locale resuelto en el servidor. Determina <html lang> y los metadatos. */
  locale: Locale;
  /** Ruta canonica de la pagina, por ejemplo "/" o "/en/". */
  path: string;
}

declare global {
  interface Window {
    dataLayer: unknown[];
  }
}

const { description, title, locale, path } = Astro.props;

// URL canonica de esta pagina y de su alternativa en el otro idioma.
const canonical = new URL(path, SITE_URL).href;
const esUrl = new URL(pathForLocale('es'), SITE_URL).href;
const enUrl = new URL(pathForLocale('en'), SITE_URL).href;
const ogImage = new URL(OG_IMAGE[locale], SITE_URL).href;
const ogLocale = locale === 'es' ? 'es_ES' : 'en_GB';
const ogLocaleAlternate = locale === 'es' ? 'en_GB' : 'es_ES';

const skipLabel = locale === 'es' ? 'Saltar al contenido' : 'Skip to content';

// Datos estructurados: una sola persona, descrita de forma verificable.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: SITE.name,
      url: `${SITE_URL}/`,
      email: `mailto:${SITE.email}`,
      jobTitle:
        locale === 'es'
          ? 'Operaciones hoteleras y desarrollo web'
          : 'Hotel operations and web development',
      description,
      sameAs: [SITE.linkedin, SITE.github],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Girona',
        addressRegion: 'Catalunya',
        addressCountry: 'ES',
      },
      knowsLanguage: ['es', 'ca', 'en', 'it', 'fr'],
      hasOccupation: {
        '@type': 'Occupation',
        name:
          locale === 'es'
            ? 'Operaciones hoteleras y tecnología'
            : 'Hotel operations and technology',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE.name,
      inLanguage: locale,
      publisher: { '@id': `${SITE_URL}/#person` },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: locale,
      isPartOf: { '@id': `${SITE_URL}/#website` },
      about: { '@id': `${SITE_URL}/#person` },
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Canonical y alternativas por idioma -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <!-- x-default apunta a la version inglesa: es la que se comparte desde LinkedIn -->
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="profile:first_name" content="Santiago" />
    <meta property="profile:last_name" content="Martelli" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <title>{title}</title>

    <!--
      Tema antes del primer pintado. El mundo por defecto es papel claro, asi que
      la clase se fija aqui para que no haya destello al hidratar.
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme = stored === "light" || stored === "dark" ? stored : "light";
          document.documentElement.classList.add(theme);
        } catch (error) {
          document.documentElement.classList.add("light");
        }
      })();
    </script>

    <!-- Google Analytics (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4SEW399N9F"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-4SEW399N9F");
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Restaura la posicion de scroll despues de cambiar de idioma -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        var storedPosition = sessionStorage.getItem("scrollPosition");
        if (!storedPosition) return;
        try {
          var position = JSON.parse(storedPosition);
          requestAnimationFrame(function () {
            window.scrollTo({ left: position.x, top: position.y, behavior: "instant" });
          });
          sessionStorage.removeItem("scrollPosition");
        } catch (error) {
          sessionStorage.removeItem("scrollPosition");
        }
      });
    </script>
  </head>
  <body class="bg-paper text-body font-sans antialiased">
    <a class="skip-link" href="#home">{skipLabel}</a>

    <slot />
  </body>

  <style is:global>
    /* ==========================================================
       TOKENS
       Dos temas del mismo mundo: papel calido de dia, tinta calida
       de noche. El acento ambar solo aparece como bano o filete;
       para texto sobre papel existe --accent-ink, que si contrasta.
       ========================================================== */
    :root,
    .light {
      --paper: #faf9f6;
      --paper-raised: #ffffff;
      --paper-sunk: #f1efe8;

      --ink: #17160f;
      --body: #2e2c26;
      --muted: #635e54;
      --faint: #6f6b5e;

      --rule: rgba(23, 22, 15, 0.13);
      --rule-strong: rgba(23, 22, 15, 0.28);

      --accent: #e0a63a;
      --accent-ink: #7d5102;
      --accent-wash: rgba(224, 166, 58, 0.16);
      --patina: #1c646d;

      color-scheme: light;
    }

    .dark {
      --paper: #14130f;
      --paper-raised: #1c1a15;
      --paper-sunk: #100f0c;

      --ink: #f6f3ec;
      --body: #d9d4c8;
      --muted: #a49e90;
      --faint: #948e80;

      --rule: rgba(246, 243, 236, 0.15);
      --rule-strong: rgba(246, 243, 236, 0.3);

      --accent: #e0a63a;
      --accent-ink: #eab95e;
      --accent-wash: rgba(224, 166, 58, 0.18);
      --patina: #62b6bf;

      color-scheme: dark;
    }

    /* ==========================================================
       BASE
       ========================================================== */
    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html {
      -webkit-text-size-adjust: 100%;
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-height: 100%;
      background-color: var(--paper);
      color: var(--body);
      font-family: "Albert Sans Variable", "Albert Sans", system-ui, sans-serif;
      font-size: 1.0625rem;
      line-height: 1.7;
      font-synthesis-weight: none;
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
      transition: background-color 0.3s ease-out, color 0.3s ease-out;
    }

    h1, h2, h3, h4 {
      margin: 0;
      color: var(--ink);
      font-weight: 500;
      text-wrap: balance;
    }

    h1, h2 {
      font-family: "Alumni Sans Variable", "Alumni Sans", sans-serif;
    }

    p {
      margin: 0;
      text-wrap: pretty;
    }

    ul, ol {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    img {
      display: block;
      max-width: 100%;
    }

    /* El navbar es fijo: evita que tape el titular al saltar a una seccion. */
    section[id] {
      scroll-margin-top: 5.5rem;
    }

    /* ==========================================================
       SUPERFICIES DEL NAVEGADOR
       Lo que no dibujamos tambien lleva el diseno: seleccion,
       cursor, scrollbar, subrayados y cifras tabulares.
       ========================================================== */
    ::selection {
      background-color: var(--accent-wash);
      color: var(--ink);
    }

    :where(input, textarea) {
      caret-color: var(--accent-ink);
    }

    :where(a) {
      color: var(--accent-ink);
      text-decoration-thickness: 1px;
      text-underline-offset: 0.22em;
      text-decoration-color: var(--rule-strong);
      transition: text-decoration-color 0.2s ease-out, color 0.2s ease-out;
    }

    :where(a):hover {
      text-decoration-color: currentColor;
    }

    :where(.font-mono, code, kbd, samp, time) {
      font-variant-numeric: tabular-nums;
    }

    * {
      scrollbar-width: thin;
      scrollbar-color: var(--rule-strong) transparent;
    }

    ::-webkit-scrollbar {
      width: 10px;
      height: 10px;
    }

    ::-webkit-scrollbar-track {
      background: transparent;
    }

    ::-webkit-scrollbar-thumb {
      background-color: var(--rule-strong);
      border: 3px solid var(--paper);
      border-radius: 0;
    }

    :focus-visible {
      outline: 2px solid var(--accent-ink);
      outline-offset: 3px;
      border-radius: 1px;
    }

    /* ==========================================================
       ENLACE DE SALTO
       ========================================================== */
    .skip-link {
      position: absolute;
      left: 1rem;
      top: -5rem;
      z-index: 100;
      padding: 0.7rem 1.1rem;
      background-color: var(--paper-raised);
      color: var(--ink);
      border: 1px solid var(--rule-strong);
      font-size: 0.8125rem;
      text-decoration: none;
      transition: top 0.18s ease-out;
    }

    .skip-link:focus {
      top: 1rem;
    }

    /* ==========================================================
       EL UNICO MOMENTO DE MOTION
       El nombre se descubre con un barrido de mascara al cargar.
       Arranca de un estado ya visible: si la animacion no corre
       (sin CSS, con movimiento reducido o sin soporte), el texto
       esta ahi igual. No hay animaciones de entrada por seccion.
       ========================================================== */
    @keyframes name-reveal {
      from {
        clip-path: inset(0 0 105% 0);
      }
      to {
        clip-path: inset(0 0 -5% 0);
      }
    }

    .name-reveal {
      animation: name-reveal 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }

      .name-reveal {
        animation: none;
      }
    }
  </style>
</html>
