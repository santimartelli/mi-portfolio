---
// Layout principal: metadatos por idioma, SEO, accesibilidad y sistema de temas.
import "../styles/fonts.css";
// La URL con hash del subset latino, para precargarla. Es el mismo archivo que
// referencia fonts.css, asi que Vite emite una sola copia y el preload apunta a
// la que realmente se descarga.
import manropeLatinUrl from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";

import type { Locale } from "../util/i18n";
import { OG_IMAGE, SITE, SITE_URL, pathForLocale } from "../util/site";

interface Props {
  title: string;
  description: string;
  /** Locale resuelto en el servidor. Determina <html lang> y los metadatos. */
  locale: Locale;
  /** Ruta canónica de la página, por ejemplo "/" o "/en/". */
  path: string;
}

declare global {
  interface Window {
    dataLayer: unknown[];
  }
}

const { description, title, locale, path } = Astro.props;

// URL canónica de esta página y de su alternativa en el otro idioma.
const canonical = new URL(path, SITE_URL).href;
const esUrl = new URL(pathForLocale('es'), SITE_URL).href;
const enUrl = new URL(pathForLocale('en'), SITE_URL).href;
const ogImage = new URL(OG_IMAGE[locale], SITE_URL).href;
const ogLocale = locale === 'es' ? 'es_ES' : 'en_GB';
const ogLocaleAlternate = locale === 'es' ? 'en_GB' : 'es_ES';

const skipLabel = locale === 'es' ? 'Saltar al contenido' : 'Skip to content';

// Datos estructurados: una sola persona, descrita de forma verificable.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: SITE.name,
      url: `${SITE_URL}/`,
      email: `mailto:${SITE.email}`,
      jobTitle:
        locale === 'es'
          ? 'Operaciones hoteleras y desarrollo web'
          : 'Hotel operations and web development',
      description,
      sameAs: [SITE.linkedin, SITE.github],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Girona',
        addressRegion: 'Catalunya',
        addressCountry: 'ES',
      },
      knowsLanguage: ['es', 'ca', 'en', 'it', 'fr'],
      hasOccupation: {
        '@type': 'Occupation',
        name:
          locale === 'es'
            ? 'Operaciones hoteleras y tecnología'
            : 'Hotel operations and technology',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE.name,
      inLanguage: locale,
      publisher: { '@id': `${SITE_URL}/#person` },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: locale,
      isPartOf: { '@id': `${SITE_URL}/#website` },
      about: { '@id': `${SITE_URL}/#person` },
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Tipografia: se precarga el subset latino para que Manrope este lista
         cuando la pagina pinta. Sin esto el navegador solo descubre la fuente
         despues de analizar el CSS, llega tarde y la pagina cambiaba de
         tipografia a la vista. El crossorigin es obligatorio en fuentes, incluso
         siendo del mismo origen. -->
    <link rel="preload" as="font" type="font/woff2" href={manropeLatinUrl} crossorigin />

    <!-- Canonical y alternativas por idioma -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <!-- x-default apunta a la versión inglesa: es la que se comparte desde LinkedIn -->
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="profile:first_name" content="Santiago" />
    <meta property="profile:last_name" content="Martelli" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <title>{title}</title>

    <!-- Google Analytics (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4SEW399N9F"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-4SEW399N9F");
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Restaura la posición de scroll después de cambiar de idioma -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        var storedPosition = sessionStorage.getItem("scrollPosition");
        if (!storedPosition) return;
        try {
          var position = JSON.parse(storedPosition);
          requestAnimationFrame(function () {
            window.scrollTo({ left: position.x, top: position.y, behavior: "instant" });
          });
          sessionStorage.removeItem("scrollPosition");
        } catch (error) {
          sessionStorage.removeItem("scrollPosition");
        }
      });
    </script>
  </head>
  <body class="flex flex-col bg-darkbg-950 text-darktext-300">
    <a class="skip-link" href="#home">{skipLabel}</a>

    <slot />
  </body>

  <style is:global>
    /*
     * Tokens del sitio. El tema es unico y claro: el selector de tema se retiro
     * a peticion del usuario, asi que no hay dos juegos de valores ni reglas que
     * compitan por ellos. Los nombres --darkbg-* y --darktext-* se conservan
     * porque de ellos dependen las utilidades de Tailwind (bg-darkbg-950,
     * text-darktext-300) y la tabla de remapeo: lo que cambio es su valor, no su
     * nombre.
     */
    :root {
      color-scheme: light;

      /*
       * Fuente unica del sitio. Manrope es una geometrica con buena
       * legibilidad, asi que sirve tanto para titulares como para el cuerpo.
       */
      --font-sans: "Manrope Variable", Manrope, system-ui, sans-serif;

      /*
       * Tamano del titular del hero. El resto de la escala vive en el tema de
       * Tailwind, pero este valor se queda aqui a proposito: la config de
       * Tailwind no se recarga en caliente en el servidor de desarrollo, y este
       * es el unico paso que se ajusta a ojo. Aqui el cambio se ve al instante,
       * sin reiniciar nada. La utilidad .text-display lo consume con var().
       *
       * El valor de escritorio es el original; en pantallas estrechas baja un
       * escalon mas abajo, en el media query de despues del bloque.
       */
      --text-display: clamp(2.75rem, 4.6vw, 4.25rem);

      /* === BACKGROUNDS === */
      --darkbg-950: #ffffff;           /* Fondo principal puro */
      --darkbg-900: #f8fafc;           /* Fondo secundario */
      --darkbg-800: #f1f5f9;           /* Fondo de tarjetas */
      --darkbg-700: #e2e8f0;           /* Fondo hover */
      --darkbg-600: #cbd5e1;           /* Bordes */

      /* === TEXTOS === */
      --darktext-50: #0f172a;          /* Texto principal oscuro */
      --darktext-100: #1e293b;         /* Texto enfático */
      --darktext-200: #334155;         /* Texto normal */
      --darktext-300: #475569;         /* Texto secundario */
      --darktext-400: #64748b;         /* Texto muted */
      --darktext-500: #94a3b8;         /* Texto disabled */

      /* === ACCENTS === */
      --accent-primary: #2563eb;       /* Azul más oscuro para contraste */
      --on-accent: #ffffff;            /* Texto sobre el acento: 5.17:1 */
      --accent-primary-hover: #1d4ed8;
      --accent-secondary: #0891b2;     /* Cian más oscuro */
      --accent-tertiary: #7c3aed;      /* Púrpura más oscuro */
      --accent-success: #059669;       /* Verde más oscuro */
      --accent-warning: #d97706;       /* Ámbar más oscuro */
      --accent-error: #dc2626;         /* Rojo más oscuro */

      /* === SISTEMA UNIFICADO === */
      --bg-primary: var(--darkbg-950);
      --bg-secondary: var(--darkbg-900);
      --bg-tertiary: var(--darkbg-800);
      --bg-quaternary: var(--darkbg-700);
      --bg-hover: var(--darkbg-700);

      --text-primary: var(--darktext-50);
      --text-secondary: var(--darktext-200);
      --text-tertiary: var(--darktext-300);
      --text-muted: var(--darktext-400);

      --accent: var(--accent-primary);
      --accent-hover: var(--accent-primary-hover);
      --border-primary: rgba(37, 99, 235, 0.2);
      --border-secondary: rgba(37, 99, 235, 0.1);
      --shadow-primary: rgba(37, 99, 235, 0.1);
    }

    /*
     * En pantallas estrechas el titular baja: 28 a 40px en vez de 44 a 68px. El
     * corte es el mismo que usa la rejilla del hero para pasar a dos columnas,
     * asi que el tamaño pequeño acompaña a la version apilada.
     */
    @media (max-width: 1023.98px) {
      :root {
        --text-display: clamp(1.75rem, 3.2vw, 2.5rem);
      }
    }

    /* Reset de CSS base */
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    /* Indicador de foco visible y consistente. `:focus-visible` evita el anillo
       en clics de ratón y lo mantiene al navegar con teclado. */
    :focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
      border-radius: 2px;
    }

    /* La barra de navegación es fija: evita que tape el título al saltar a una sección */
    section[id] {
      scroll-margin-top: 5.5rem;
    }

    /* Enlace de salto al contenido, visible solo al recibir foco */
    .skip-link {
      position: absolute;
      left: 1rem;
      top: -4rem;
      z-index: 100;
      padding: 0.75rem 1.25rem;
      background-color: var(--bg-tertiary);
      color: var(--text-primary);
      border: 1px solid var(--accent);
      font-size: 0.875rem;
      text-decoration: none;
      transition: top 0.2s ease;
    }

    .skip-link:focus {
      top: 1rem;
    }

    /* Desplegables de la barra: `<details>` nativo.
       Abrir y cerrar lo hace el navegador, sin una sola linea de JavaScript, que
       es lo que hace que funcionen aunque la isla no llegue a hidratarse. El
       estado vive en el atributo `[open]`, asi que el CSS no necesita saber nada
       de React: las tres barras se cruzan en aspa y el panel aparece solo con
       eso. El panel se pinta siempre (el navegador esconde los hijos de un
       `<details>` cerrado, y aqui se recupera con `display: block`) para poder
       transicionar: cerrado esta invisible, sin raton y 4px mas arriba; abierto,
       en su sitio. Es una transicion de estado, con la duracion y la curva de la
       casa (200ms, arranque inmediato). */
    .dropdown > summary {
      list-style: none;
      cursor: pointer;
    }

    .dropdown > summary::-webkit-details-marker {
      display: none;
    }

    .dropdown > .dropdown-panel {
      display: block;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-0.25rem);
      pointer-events: none;
      transition:
        opacity 0.2s cubic-bezier(0, 0, 0.2, 1),
        transform 0.2s cubic-bezier(0, 0, 0.2, 1),
        visibility 0.2s;
    }

    .dropdown[open] > .dropdown-panel {
      visibility: visible;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .dropdown[open] > summary .menu-bar:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }

    .dropdown[open] > summary .menu-bar:nth-child(2) {
      opacity: 0;
      transform: translateX(20px);
    }

    .dropdown[open] > summary .menu-bar:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }

    @media (prefers-reduced-motion: reduce) {
      .dropdown > .dropdown-panel,
      .dropdown > summary .menu-bar {
        transition: none;
      }
    }

    html,
    body {
      height: 100%;
      /* El contenedor de scroll es <html>, no <main>: tenerlo en main no hacia nada. */
      scroll-behavior: smooth;
      font-family: var(--font-sans);
      background-color: var(--bg-primary);
      color: var(--text-primary);
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    main {
      display: flex;
      flex-direction: column;
      margin: 0;
      padding: 0;
      background-color: var(--bg-primary);
    }

    ::selection {
      background-color: var(--accent);
      color: var(--bg-primary);
    }

    /* Respeta la preferencia de movimiento reducido. */
    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }

      html {
        scroll-behavior: auto;
      }
    }

    /* ========================================
       🎯 MAPEO DINÁMICO DE CLASES EXISTENTES
       ======================================== */

    /* === BACKGROUNDS === */
    .bg-darkbg-950, .bg-\[0B0C10\], .bg-\[\#0B0C10\] {
      background-color: var(--bg-primary) !important;
    }

    .bg-darkbg-900, .bg-\[1F2833\], .bg-\[\#1F2833\] {
      background-color: var(--bg-secondary) !important;
    }

    .bg-darkbg-800 {
      background-color: var(--bg-tertiary) !important;
    }

    .bg-darkbg-700 {
      background-color: var(--bg-quaternary) !important;
    }

    /* === TEXTOS === */
    .text-white {
      color: var(--text-primary) !important;
    }

    .text-darktext-300 {
      color: var(--text-secondary) !important;
    }

    .text-darktext-400 {
      color: var(--text-muted) !important;
    }

    /* === ACCENTS === */
    .text-accent-400 {
      color: var(--accent) !important;
    }

    .text-accent-500 {
      color: var(--accent-hover) !important;
    }

    .bg-accent-400, .bg-accent-500 {
      background-color: var(--accent) !important;
    }

    /* === BORDES === */
    .border-accent-500 {
      border-color: var(--accent) !important;
    }

    .border-accent-500\/30 {
      border-color: var(--border-primary) !important;
    }

    .border-accent-500\/20 {
      border-color: var(--border-secondary) !important;
    }

    .border-accent-500\/10 {
      border-color: color-mix(in srgb, var(--accent) 10%, transparent) !important;
    }

    /* === HOVERS Y ESTADOS === */
    .hover\:bg-darkbg-900\/70:hover, .hover\:bg-darkbg-900\/50:hover {
      background-color: var(--bg-hover) !important;
      transition: all 0.2s ease !important;
    }

    .hover\:text-white:hover {
      color: var(--text-primary) !important;
      transition: color 0.2s ease !important;
    }

    .hover\:text-accent-400:hover {
      color: var(--accent-hover) !important;
      transition: color 0.2s ease !important;
    }

    /* === GRADIENTS DINÁMICOS === */
    .from-accent-400 {
      --tw-gradient-from: var(--accent) var(--tw-gradient-from-position) !important;
    }

    .to-accent-500 {
      --tw-gradient-to: var(--accent-hover) var(--tw-gradient-to-position) !important;
    }

    .from-darkbg-900 {
      --tw-gradient-from: var(--bg-secondary) var(--tw-gradient-from-position) !important;
    }

    .to-darkbg-950 {
      --tw-gradient-to: var(--bg-primary) var(--tw-gradient-to-position) !important;
    }

    /* === TRANSPARENCIAS === */
    .bg-darkbg-950\/90 {
      background-color: color-mix(in srgb, var(--bg-primary) 90%, transparent) !important;
    }

    .bg-darkbg-950\/70 {
      background-color: color-mix(in srgb, var(--bg-primary) 70%, transparent) !important;
    }

    .bg-darkbg-900\/80 {
      background-color: color-mix(in srgb, var(--bg-secondary) 80%, transparent) !important;
    }

    /* === DIVIDERS === */
    .divide-accent-500\/10 > * + * {
      border-color: color-mix(in srgb, var(--accent) 10%, transparent) !important;
    }

    /* ==========================================
       LLAMADA A LA ACCION
       Al final no queda nada del boton portado: se le fueron quitando la sombra,
       el labio, la elevacion, el brillo y la forma de pastilla. Lo que hay es el
       mismo recurso que usan los iconos de contacto: un cambio de color con
       transicion al pasar el puntero, sin animacion ni movimiento. Los colores
       son los del mundo: tinta de fondo, papel en el texto y tinta suave al
       pasar por encima (9,7:1 con el texto blanco).

       Se define con los tokens y no con utilidades de acento porque la tabla de
       remapeo casa nombres exactos de clase, asi que cualquier variante
       (hover:, dark:) se le escapa y cae en la paleta antigua.
       ========================================== */
    .cta-primary {
      border: 0;
      border-radius: 8px;
      background-color: var(--text-primary);
      color: var(--bg-primary);
      /* Mismo tempo que los iconos: 200ms y la curva de salida de Tailwind. */
      transition: background-color 0.2s cubic-bezier(0, 0, 0.2, 1);
    }

    .cta-primary:hover {
      background-color: var(--text-secondary);
    }

    /*
     * Boton secundario del hero, para la segunda accion (proyectos). Mismo
     * cuerpo, mismo radio y mismo tempo que el primario, porque son la misma
     * familia, pero sin relleno: se declara con el filete de 1px, que es como se
     * declara la profundidad en este mundo, y al pasar el puntero solo cambia el
     * gris del filete a tinta. Asi la accion principal sigue siendo una sola y
     * las dos no compiten.
     */
    .cta-secondary {
      border: 1px solid var(--darkbg-600);
      border-radius: 8px;
      color: var(--text-primary);
      transition: border-color 0.2s cubic-bezier(0, 0, 0.2, 1);
    }

    .cta-secondary:hover {
      border-color: var(--text-primary);
    }

    /* ==========================================
       MARQUEE DE CARACTERISTICAS
       La lista va dos veces dentro de una pista que se desplaza la mitad de su
       ancho, asi que el bucle no tiene costura: al llegar al final, la segunda
       copia ocupa exactamente el sitio de la primera. La copia duplicada lleva
       aria-hidden en el marcado para que quien use lector de pantalla no oiga la
       lista dos veces.

       Se para con el puntero encima o con el foco dentro, que es lo minimo para
       que se pueda leer algo que se mueve solo.

       Los costados se difuminan con una mascara del propio lienzo (alpha), no
       con un degradado de color: sobre el papel claro un color dejaria halo y
       ademas ataria el efecto al fondo. La distancia es relativa al ancho, para
       que el desvanecido crezca con la pantalla, con suelo para que en movil se
       note y tope para que en pantallas anchas no se coma media fila: asi la
       pieza nunca se corta a media palabra contra el borde. El negro del
       degradado es opacidad de mascara, no un color de la paleta.

       Bajo prefers-reduced-motion no hay recorrido: la pista se queda quieta al
       principio y solo se difumina el costado derecho, que es el que sigue
       teniendo contenido detras.
       ========================================== */
    .marquee {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        black clamp(2.5rem, 8%, 10rem),
        black calc(100% - clamp(2.5rem, 8%, 10rem)),
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0,
        black clamp(2.5rem, 8%, 10rem),
        black calc(100% - clamp(2.5rem, 8%, 10rem)),
        transparent 100%
      );
    }

    .marquee-track {
      display: flex;
      width: max-content;
      animation: marquee 60s linear infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .marquee {
        -webkit-mask-image: linear-gradient(to right, black 0, black 85%, transparent 100%);
        mask-image: linear-gradient(to right, black 0, black 85%, transparent 100%);
      }

      .marquee-track {
        animation: none;
      }
    }

    .marquee:hover .marquee-track,
    .marquee:focus-within .marquee-track {
      animation-play-state: paused;
    }

    @keyframes marquee {
      to {
        transform: translateX(-50%);
      }
    }

    /* ==========================================
       FILETE QUE ABRE CADA SECCION
       Cada seccion se separa de la anterior con una sola regla de 1px: la
       misma que dibujaba el Divider que se retiro, un gris que se desvanece en
       los dos costados para que la linea no toque los bordes de la pantalla.
       Va como fondo del propio elemento (1px de alto) y no con border-top,
       porque un borde no admite degradado; asi no hay que meter un elemento
       extra ni posicionar nada. El gris es gray-300 al 60%, que es el color
       exacto que tenia aquel separador.

       La regla cae en el borde superior de la seccion, asi que para que quede
       centrada entre el contenido de arriba y el de abajo el aire tiene que ser
       el mismo a los dos lados. Casi siempre lo es, porque cada seccion reserva
       abajo lo mismo que la siguiente arriba (py-20 sm:py-28, o sea 5rem y
       7rem). La excepcion es el hero: reserva abajo 1.5rem por debajo de lg y
       4rem desde lg (que es lo que deja el marquee centrado en la franja que
       queda entre la ilustracion y el borde de la pantalla), y ahi la regla se
       mete hacia dentro de About la mitad de la diferencia (--rule-offset), de
       modo que aparece un poco por debajo del pliegue en vez de en el borde. Si
       se cambia el aire de abajo del hero o el de arriba de About, hay que
       rehacer esas cuentas.
       Los filetes de dentro de cada seccion, los que separan unidades, siguen
       siendo solidos (border-t border-gray-200).
       ========================================== */
    .section-rule {
      background-image: linear-gradient(
        to right,
        transparent,
        rgb(209 213 219 / 0.6),
        transparent
      );
      background-size: 100% 1px;
      background-position: 0 var(--rule-offset, 0);
      background-repeat: no-repeat;
    }

    /*
     * Desplazamiento de la regla cuando el bloque de arriba reserva abajo menos
     * aire que el de abajo arriba: la mitad de la diferencia, medida desde el
     * borde superior de la seccion. Solo pasa entre el hero y About. Las cuentas,
     * con el aire de abajo del hero y el de arriba de About en cada escalon:
     * (5rem - 1.5rem) / 2, (7rem - 1.5rem) / 2 y (7rem - 4rem) / 2.
     */
    .section-rule-hero {
      --rule-offset: 1.75rem;
    }

    @media (min-width: 640px) {
      .section-rule-hero { --rule-offset: 2.75rem; }
    }

    @media (min-width: 1024px) {
      .section-rule-hero { --rule-offset: 1.5rem; }
    }

    /* ==========================================
       ANCHO Y LECTURA
       Las secciones cruzan la pantalla; el texto se queda en una
       columna legible. Ocupar todo el ancho no puede costar lectura.
       ========================================== */
    /*
     * Margen lateral de la pagina. Crece por escalones y en escritorio manda: el
     * hero y las secciones dejan mucho aire en los bordes y poco en el centro,
     * que es lo que hace que el contenido se lea como un bloque centrado y no
     * como algo pegado a los lados. El escalon de 1024px ya es de 4rem, el mismo
     * que el padding horizontal de la barra de navegacion, para que el logotipo
     * y el contenido empiecen en la misma vertical; los dos suben juntos a 5rem
     * y 6rem en los escalones siguientes.
     */
    .shell {
      margin-inline: auto;
      width: 100%;
      max-width: 1600px;
      padding-inline: 1.25rem;
    }

    @media (min-width: 640px) {
      .shell { padding-inline: 1.75rem; }
    }

    @media (min-width: 1024px) {
      .shell { padding-inline: 4rem; }
    }

    @media (min-width: 1280px) {
      .shell { padding-inline: 5rem; }
    }

    @media (min-width: 1536px) {
      .shell { padding-inline: 6rem; }
    }

    /* Medida de lectura: 64ch, dentro del rango 45-75ch. */
    .measure {
      max-width: 64ch;
    }

    /*
     * Recorte de la ilustracion del hero. Hay dos versiones de la misma escena y
     * el <picture> elige una: la apaisada en pantallas estrechas y la vertical
     * desde lg. Aqui se fija el tamaño de cada una.
     *
     * En movil ocupa el ancho completo con su proporcion apaisada (1,78), que es
     * lo que la deja ancha y baja a la vez. Desde lg vuelve a proporcion
     * automatica, para que el tope de alto pueda encogerla conservando la suya
     * sin deformarla: con una proporcion fija y el ancho al 100%, cualquier tope
     * de alto la aplasta.
     *
     * Desde lg la imagen se pega al borde derecho de su columna, no se centra en
     * ella. El bloque de texto arranca en el borde izquierdo del contenedor, asi
     * que con la imagen en el derecho las dos mitades quedan a la misma
     * distancia del borde de la pagina, que es lo que hace que el hero se lea
     * centrado y alineado con la rejilla del resto de secciones. Centrada en su
     * columna, la imagen solo llegaba a su borde cuando el tope de alto no
     * encogia lo bastante: el aire que le sobraba a la derecha era justo lo que
     * descentraba la composicion. Ese es el unico eje que cambia; el vertical
     * sigue centrado por el propio grid.
     *
     * Va en el CSS global y no con utilidades de Tailwind a proposito. Con
     * `lg:aspect-auto` Tailwind emitia ademas un `.aspect-auto` suelto y global,
     * que por orden de fuente ganaba al aspect-ratio de movil y dejaba la imagen
     * con la proporcion del retrato.
     */
    .hero-media {
      width: 100%;
      height: auto;
      aspect-ratio: 1400 / 611;
    }

    @media (min-width: 1024px) {
      .hero-media {
        width: auto;
        max-width: 100%;
        aspect-ratio: auto;
        max-height: calc(100vh - 16rem);
        margin-inline-start: auto;
        margin-inline-end: 0;
      }
    }

    /* ==========================================
       SUPERFICIES DEL NAVEGADOR
       Lo que no dibujamos tambien lleva el diseno: cursor,
       scrollbar, subrayados y cifras tabulares.
       ========================================== */
    :where(input, textarea) {
      caret-color: var(--accent);
    }

    a {
      text-decoration-thickness: 1px;
      text-underline-offset: 0.22em;
    }

    :where(code, kbd, samp, time, .tabular) {
      font-variant-numeric: tabular-nums;
    }

    * {
      scrollbar-width: thin;
      scrollbar-color: var(--darkbg-600) transparent;
    }

    ::-webkit-scrollbar {
      width: 10px;
      height: 10px;
    }

    ::-webkit-scrollbar-track {
      background: transparent;
    }

    ::-webkit-scrollbar-thumb {
      background-color: var(--darkbg-600);
      border: 3px solid var(--bg-primary);
      border-radius: 999px;
    }

  </style>
</html>
