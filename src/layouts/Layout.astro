---
// Layout principal: metadatos por idioma, SEO, accesibilidad y sistema de temas.
import "../styles/fonts.css";
// La URL con hash del subset latino, para precargarla. Es el mismo archivo que
// referencia fonts.css, asi que Vite emite una sola copia y el preload apunta a
// la que realmente se descarga.
import manropeLatinUrl from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";

import type { Locale } from "../util/i18n";
import { OG_IMAGE, SITE, SITE_URL, pathForLocale } from "../util/site";

interface Props {
  title: string;
  description: string;
  /** Locale resuelto en el servidor. Determina <html lang> y los metadatos. */
  locale: Locale;
  /** Ruta canónica de la página, por ejemplo "/" o "/en/". */
  path: string;
}

declare global {
  interface Window {
    dataLayer: unknown[];
  }
}

const { description, title, locale, path } = Astro.props;

// URL canónica de esta página y de su alternativa en el otro idioma.
const canonical = new URL(path, SITE_URL).href;
const esUrl = new URL(pathForLocale('es'), SITE_URL).href;
const enUrl = new URL(pathForLocale('en'), SITE_URL).href;
const ogImage = new URL(OG_IMAGE[locale], SITE_URL).href;
const ogLocale = locale === 'es' ? 'es_ES' : 'en_GB';
const ogLocaleAlternate = locale === 'es' ? 'en_GB' : 'es_ES';

const skipLabel = locale === 'es' ? 'Saltar al contenido' : 'Skip to content';

// Datos estructurados: una sola persona, descrita de forma verificable.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      name: SITE.name,
      url: `${SITE_URL}/`,
      email: `mailto:${SITE.email}`,
      jobTitle:
        locale === 'es'
          ? 'Operaciones hoteleras y desarrollo web'
          : 'Hotel operations and web development',
      description,
      sameAs: [SITE.linkedin, SITE.github],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Girona',
        addressRegion: 'Catalunya',
        addressCountry: 'ES',
      },
      knowsLanguage: ['es', 'ca', 'en', 'it', 'fr'],
      hasOccupation: {
        '@type': 'Occupation',
        name:
          locale === 'es'
            ? 'Operaciones hoteleras y tecnología'
            : 'Hotel operations and technology',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE.name,
      inLanguage: locale,
      publisher: { '@id': `${SITE_URL}/#person` },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: locale,
      isPartOf: { '@id': `${SITE_URL}/#website` },
      about: { '@id': `${SITE_URL}/#person` },
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Tipografia: se precarga el subset latino para que Manrope este lista
         cuando la pagina pinta. Sin esto el navegador solo descubre la fuente
         despues de analizar el CSS, llega tarde y la pagina cambiaba de
         tipografia a la vista. El crossorigin es obligatorio en fuentes, incluso
         siendo del mismo origen. -->
    <link rel="preload" as="font" type="font/woff2" href={manropeLatinUrl} crossorigin />

    <!-- Canonical y alternativas por idioma -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <!-- x-default apunta a la versión inglesa: es la que se comparte desde LinkedIn -->
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="profile:first_name" content="Santiago" />
    <meta property="profile:last_name" content="Martelli" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <title>{title}</title>

    <!-- Google Analytics (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4SEW399N9F"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-4SEW399N9F");
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Restaura la posición de scroll después de cambiar de idioma -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        var storedPosition = sessionStorage.getItem("scrollPosition");
        if (!storedPosition) return;
        try {
          var position = JSON.parse(storedPosition);
          requestAnimationFrame(function () {
            window.scrollTo({ left: position.x, top: position.y, behavior: "instant" });
          });
          sessionStorage.removeItem("scrollPosition");
        } catch (error) {
          sessionStorage.removeItem("scrollPosition");
        }
      });
    </script>
  </head>
  <body class="flex flex-col bg-darkbg-950 text-darktext-300">
    <a class="skip-link" href="#home">{skipLabel}</a>

    <slot />
  </body>

  <style is:global>
    /*
     * Tokens del sitio. El tema es unico y claro: el selector de tema se retiro
     * a peticion del usuario, asi que no hay dos juegos de valores ni reglas que
     * compitan por ellos. Los nombres --darkbg-* y --darktext-* se conservan
     * porque de ellos dependen las utilidades de Tailwind (bg-darkbg-950,
     * text-darktext-300) y la tabla de remapeo: lo que cambio es su valor, no su
     * nombre.
     */
    :root {
      color-scheme: light;

      /*
       * Fuente unica del sitio. Manrope es una geometrica con buena
       * legibilidad, asi que sirve tanto para titulares como para el cuerpo.
       */
      --font-sans: "Manrope Variable", Manrope, system-ui, sans-serif;

      /*
       * Tamano del titular del hero. El resto de la escala vive en el tema de
       * Tailwind, pero este valor se queda aqui a proposito: la config de
       * Tailwind no se recarga en caliente en el servidor de desarrollo, y este
       * es el unico paso que se ajusta a ojo. Aqui el cambio se ve al instante,
       * sin reiniciar nada. La utilidad .text-display lo consume con var().
       *
       * El valor de escritorio es el original; en pantallas estrechas baja un
       * escalon mas abajo, en el media query de despues del bloque.
       */
      --text-display: clamp(2.75rem, 4.6vw, 4.25rem);

      /* === BACKGROUNDS === */
      --darkbg-950: #ffffff;           /* Fondo principal puro */
      --darkbg-900: #f8fafc;           /* Fondo secundario */
      --darkbg-800: #f1f5f9;           /* Fondo de tarjetas */
      --darkbg-700: #e2e8f0;           /* Fondo hover */
      --darkbg-600: #cbd5e1;           /* Bordes */

      /* === TEXTOS === */
      --darktext-50: #0f172a;          /* Texto principal oscuro */
      --darktext-100: #1e293b;         /* Texto enfático */
      --darktext-200: #334155;         /* Texto normal */
      --darktext-300: #475569;         /* Texto secundario */
      --darktext-400: #64748b;         /* Texto muted */
      --darktext-500: #94a3b8;         /* Texto disabled */

      /* === ACCENTS === */
      --accent-primary: #2563eb;       /* Azul más oscuro para contraste */
      --on-accent: #ffffff;            /* Texto sobre el acento: 5.17:1 */
      --accent-primary-hover: #1d4ed8;
      --accent-secondary: #0891b2;     /* Cian más oscuro */
      --accent-tertiary: #7c3aed;      /* Púrpura más oscuro */
      --accent-success: #059669;       /* Verde más oscuro */
      --accent-warning: #d97706;       /* Ámbar más oscuro */
      --accent-error: #dc2626;         /* Rojo más oscuro */

      /* === SISTEMA UNIFICADO === */
      --bg-primary: var(--darkbg-950);
      --bg-secondary: var(--darkbg-900);
      --bg-tertiary: var(--darkbg-800);
      --bg-quaternary: var(--darkbg-700);
      --bg-hover: var(--darkbg-700);

      --text-primary: var(--darktext-50);
      --text-secondary: var(--darktext-200);
      --text-tertiary: var(--darktext-300);
      --text-muted: var(--darktext-400);

      --accent: var(--accent-primary);
      --accent-hover: var(--accent-primary-hover);
      --border-primary: rgba(37, 99, 235, 0.2);
      --border-secondary: rgba(37, 99, 235, 0.1);
      --shadow-primary: rgba(37, 99, 235, 0.1);
    }

    /*
     * En pantallas estrechas el titular baja: 32 a 48px en vez de 44 a 68px. El
     * corte es el mismo que usa la rejilla del hero para pasar a dos columnas,
     * asi que el tamaño pequeño acompaña a la version apilada.
     */
    @media (max-width: 1023.98px) {
      :root {
        --text-display: clamp(2rem, 3.6vw, 3rem);
      }
    }

    /* Reset de CSS base */
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    /* Indicador de foco visible y consistente. `:focus-visible` evita el anillo
       en clics de ratón y lo mantiene al navegar con teclado. */
    :focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
      border-radius: 2px;
    }

    /* La barra de navegación es fija: evita que tape el título al saltar a una sección */
    section[id] {
      scroll-margin-top: 5.5rem;
    }

    /* Enlace de salto al contenido, visible solo al recibir foco */
    .skip-link {
      position: absolute;
      left: 1rem;
      top: -4rem;
      z-index: 100;
      padding: 0.75rem 1.25rem;
      background-color: var(--bg-tertiary);
      color: var(--text-primary);
      border: 1px solid var(--accent);
      font-size: 0.875rem;
      text-decoration: none;
      transition: top 0.2s ease;
    }

    .skip-link:focus {
      top: 1rem;
    }

    html,
    body {
      height: 100%;
      /* El contenedor de scroll es <html>, no <main>: tenerlo en main no hacia nada. */
      scroll-behavior: smooth;
      font-family: var(--font-sans);
      background-color: var(--bg-primary);
      color: var(--text-primary);
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    main {
      display: flex;
      flex-direction: column;
      margin: 0;
      padding: 0;
      background-color: var(--bg-primary);
    }

    ::selection {
      background-color: var(--accent);
      color: var(--bg-primary);
    }

    /* Respeta la preferencia de movimiento reducido. */
    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }

      html {
        scroll-behavior: auto;
      }
    }

    /* ========================================
       🎯 MAPEO DINÁMICO DE CLASES EXISTENTES
       ======================================== */

    /* === BACKGROUNDS === */
    .bg-darkbg-950, .bg-\[0B0C10\], .bg-\[\#0B0C10\] {
      background-color: var(--bg-primary) !important;
    }

    .bg-darkbg-900, .bg-\[1F2833\], .bg-\[\#1F2833\] {
      background-color: var(--bg-secondary) !important;
    }

    .bg-darkbg-800 {
      background-color: var(--bg-tertiary) !important;
    }

    .bg-darkbg-700 {
      background-color: var(--bg-quaternary) !important;
    }

    /* === TEXTOS === */
    .text-white {
      color: var(--text-primary) !important;
    }

    .text-darktext-300 {
      color: var(--text-secondary) !important;
    }

    .text-darktext-400 {
      color: var(--text-muted) !important;
    }

    /* === ACCENTS === */
    .text-accent-400 {
      color: var(--accent) !important;
    }

    .text-accent-500 {
      color: var(--accent-hover) !important;
    }

    .bg-accent-400, .bg-accent-500 {
      background-color: var(--accent) !important;
    }

    /* === BORDES === */
    .border-accent-500 {
      border-color: var(--accent) !important;
    }

    .border-accent-500\/30 {
      border-color: var(--border-primary) !important;
    }

    .border-accent-500\/20 {
      border-color: var(--border-secondary) !important;
    }

    .border-accent-500\/10 {
      border-color: color-mix(in srgb, var(--accent) 10%, transparent) !important;
    }

    /* === HOVERS Y ESTADOS === */
    .hover\:bg-darkbg-900\/70:hover, .hover\:bg-darkbg-900\/50:hover {
      background-color: var(--bg-hover) !important;
      transition: all 0.2s ease !important;
    }

    .hover\:text-white:hover {
      color: var(--text-primary) !important;
      transition: color 0.2s ease !important;
    }

    .hover\:text-accent-400:hover {
      color: var(--accent-hover) !important;
      transition: color 0.2s ease !important;
    }

    /* === GRADIENTS DINÁMICOS === */
    .from-accent-400 {
      --tw-gradient-from: var(--accent) var(--tw-gradient-from-position) !important;
    }

    .to-accent-500 {
      --tw-gradient-to: var(--accent-hover) var(--tw-gradient-to-position) !important;
    }

    .from-darkbg-900 {
      --tw-gradient-from: var(--bg-secondary) var(--tw-gradient-from-position) !important;
    }

    .to-darkbg-950 {
      --tw-gradient-to: var(--bg-primary) var(--tw-gradient-to-position) !important;
    }

    /* === TRANSPARENCIAS === */
    .bg-darkbg-950\/90 {
      background-color: color-mix(in srgb, var(--bg-primary) 90%, transparent) !important;
    }

    .bg-darkbg-950\/70 {
      background-color: color-mix(in srgb, var(--bg-primary) 70%, transparent) !important;
    }

    .bg-darkbg-900\/80 {
      background-color: color-mix(in srgb, var(--bg-secondary) 80%, transparent) !important;
    }

    /* === DIVIDERS === */
    .divide-accent-500\/10 > * + * {
      border-color: color-mix(in srgb, var(--accent) 10%, transparent) !important;
    }

    /* ==========================================
       LLAMADA A LA ACCION
       Solida, con la tinta del mundo de fondo y el color del papel como texto:
       en reposo compone 17,85:1, y al pasar por encima se enciende con el acento
       (5,17:1). Se define con los tokens y no con utilidades de acento porque la
       tabla de remapeo casa nombres exactos de clase, asi que cualquier variante
       (hover:, dark:) se le escapa y cae en la paleta antigua.
       ========================================== */
    .cta-primary {
      border: 1px solid var(--text-primary);
      color: var(--bg-primary);
      background-color: var(--text-primary);
      transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    .cta-primary:hover {
      background-color: var(--accent);
      border-color: var(--accent);
      color: var(--on-accent);
    }

    .cta-primary:active {
      background-color: var(--accent-hover);
      border-color: var(--accent-hover);
    }

    /* ==========================================
       ANCHO Y LECTURA
       Las secciones cruzan la pantalla; el texto se queda en una
       columna legible. Ocupar todo el ancho no puede costar lectura.
       ========================================== */
    .shell {
      margin-inline: auto;
      width: 100%;
      max-width: 1600px;
      padding-inline: 1.25rem;
    }

    @media (min-width: 640px) {
      .shell { padding-inline: 1.75rem; }
    }

    @media (min-width: 1024px) {
      .shell { padding-inline: 2.5rem; }
    }

    @media (min-width: 1280px) {
      .shell { padding-inline: 3rem; }
    }

    /* Medida de lectura: 64ch, dentro del rango 45-75ch. */
    .measure {
      max-width: 64ch;
    }

    /* ==========================================
       SUPERFICIES DEL NAVEGADOR
       Lo que no dibujamos tambien lleva el diseno: cursor,
       scrollbar, subrayados y cifras tabulares.
       ========================================== */
    :where(input, textarea) {
      caret-color: var(--accent);
    }

    a {
      text-decoration-thickness: 1px;
      text-underline-offset: 0.22em;
    }

    :where(code, kbd, samp, time, .tabular) {
      font-variant-numeric: tabular-nums;
    }

    * {
      scrollbar-width: thin;
      scrollbar-color: var(--darkbg-600) transparent;
    }

    ::-webkit-scrollbar {
      width: 10px;
      height: 10px;
    }

    ::-webkit-scrollbar-track {
      background: transparent;
    }

    ::-webkit-scrollbar-thumb {
      background-color: var(--darkbg-600);
      border: 3px solid var(--bg-primary);
      border-radius: 999px;
    }

  </style>
</html>
