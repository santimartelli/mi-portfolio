---
// English homepage (`/en/`). LinkedIn links here directly.
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navigation/NavbarWithTranslations";
import Hero from "../../components/sections/HeroWithTranslations";
import About from "../../components/sections/AboutWithTranslations";
import Experience from "../../components/sections/ExperienceWithTranslations";
import Skills from "../../components/sections/SkillsWithTranslations";
import Projects from "../../components/sections/ProjectsWithTranslations";
import Contact from "../../components/sections/ContactWithTranslations";
import Footer from "../../components/sections/FooterWithTranslations";
import { getTranslations } from "../../util/content";

const locale = "en" as const;
const translations = getTranslations(locale);

const title = "Santiago Martelli | Hospitality, Hotel Tech & Web Development";
const description =
  "Hospitality professional with a background in web development, combining hotel operations, guest experience, PMS and OTAs with the ability to build and maintain real digital products.";
---

<Layout {title} {description} {locale} path="/en/">
  <Navbar content={translations.navbar} locale={locale} client:load />

  <main>
    <section>
      <Hero content={translations.hero} />
    </section>

    {/* Las secciones se separan solo con el filete de 1px con el que cada una
        abre (`border-t`). El `Divider` de gradiente que iba entre ellas se
        retiro a peticion del usuario: era una segunda regla a 32px del filete.
        El ultimo que quedaba, el de debajo del hero, se fue antes. */}
    <section>
      <About content={translations.about} />
    </section>

    <section>
      <Experience content={translations.experience} client:visible />
    </section>

    <section>
      <Skills content={translations.skills} />
    </section>

    <section>
      <Projects content={translations.projects} />
    </section>

    <section>
      <Contact content={translations.contact} />
    </section>

    <Footer content={translations.footer} />
  </main>
</Layout>
