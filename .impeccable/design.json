  "narrative": {
    "northStar": "Portfolio oscuro y tecnico",
    "overview": "Un mundo casi negro con tinte azulado, tipografia ligera de gran tamano y un unico azul de senal. La estetica quiere parecer la de alguien que construye software: minimalista, geometrica, sin adornos, con el propio codigo como argumento. El contenido cuenta una sola trayectoria (hospitalidad + operaciones + tecnologia) y la tecnologia aparece como evidencia verificable, no como titular.",
    "keyCharacteristics": [
      "Fondo casi negro con tinte azulado y un unico acento saturado.",
      "Una sola familia para todo el sitio: Manrope (geometrica), con la monoespaciada del sistema solo para datos.",
      "Esquinas rectas en todo el sistema.",
      "Secciones a todo el ancho (.shell, techo 1800px) con la prosa limitada a 68ch.",
      "Unidades repetibles con la misma anatomia en lugar de tarjetas.",
      "Sin animaciones de entrada: el contenido es visible en el HTML y no depende de JavaScript.",
      "La marca es el nombre en una linea con el posicionamiento tras dos puntos, sin caja de iniciales.",
      "Layout de bandas anchas: hero, banda de trabajo en rejilla, secciones a 12 columnas, casos alternando lado y rejillas de celdas."
    ],
    "rules": [
      {
        "name": "Un solo acento",
        "body": "signal-blue es la unica senal de acento; el resto del mundo es neutro.",
        "section": "colors"
      },
      {
        "name": "Titulares en peso 300",
        "body": "El aire tecnico viene del peso ligero a gran tamano.",
        "section": "typography"
      },
      {
        "name": "Esquinas rectas",
        "body": "No se introducen radios salvo el foco, los botones y el rail del conmutador.",
        "section": "shapes"
      },
      {
        "name": "El acento no es un fondo",
        "body": "El acento es una senal, no una superficie.",
        "section": "colors"
      },
      {
        "name": "Ancho sin coste de lectura",
        "body": "Las secciones cruzan la pantalla con .shell; la prosa se limita con .measure (68ch).",
        "section": "layout"
      },
      {
        "name": "Sin animaciones de entrada",
        "body": "Nada aparece al hacer scroll. Framer Motion solo cubre transiciones funcionales.",
        "section": "motion"
      },
      {
        "name": "Una sola familia",
        "body": "Manrope en toda la web, declarada una vez en --font-sans. La monoespaciada del sistema solo para datos.",
        "section": "typography"
      }
    ],
    "dos": [
      "Usa signal-blue como unica senal de acento.",
      "Manten el peso 300 en los titulares grandes.",
      "Deja que .shell de la anchura y .measure proteja la lectura.",
      "Organiza el contenido denso en unidades repetibles con filete, no en tarjetas."
    ],
    "donts": [
      "No introduzcas una segunda familia tipografica.",
      "No anadas animaciones de entrada ni apariciones al hacer scroll.",
      "No estires la prosa a todo el ancho.",
      "No uses el acento en superficies grandes."
    ],
    "knownDeviations": [
      "Display a 8rem, por encima del techo de 6rem.",
      "Dos islas hidratadas (navbar y filtro) y ~89 kB de JS comprimido, casi todo el runtime de React."
    ]
  }
}
