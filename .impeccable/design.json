  "narrative": {
    "northStar": "Publicación profesional sobre papel cálido",
    "overview": "El portfolio se lee como una publicación, no como una landing de tarjetas. La jerarquía la hacen la escala tipográfica, el espacio y los filetes de un píxel. Dos temas del mismo mundo: papel cálido de día, tinta cálida de noche. El acento ámbar es una señal escasa, nunca un tema.",
    "keyCharacteristics": [
      "Cero elevación: ni una sombra en todo el sitio. Separan el filete de 1px y el espacio.",
      "Esquinas rectas en todo el sistema; el foco visible es lo único con radio (1px).",
      "Tres familias con trabajos disjuntos: condensada para display, sans para texto, mono solo para datos.",
      "Un solo momento de motion: el barrido del nombre. Ninguna sección tiene animación de entrada.",
      "Contenido visible por defecto: sin JavaScript no hay nada oculto y la página se lee entera."
    ],
    "rules": [
      {
        "name": "El ámbar no escribe",
        "body": "accent solo aparece como relleno, baño o punto. Cualquier texto ámbar legible usa accent-ink (6.54:1 en claro).",
        "section": "colors"
      },
      {
        "name": "Ningún kicker sobre un titular",
        "body": "Ningún titular lleva etiqueta encima. El titular se sostiene por escala y peso.",
        "section": "typography"
      },
      {
        "name": "Sin elevación",
        "body": "No se introducen sombras, halos ni desenfoques decorativos. La profundidad se declara una sola vez y con filetes.",
        "section": "elevation"
      },
      {
        "name": "El filete es la estructura",
        "body": "Las secciones y las filas se separan con border-top o border-bottom de 1px en color rule. No hay contenedores con caja.",
        "section": "layout"
      },
      {
        "name": "Techo de display",
        "body": "Ningún texto pasa de 6rem ni de -0.03em de tracking.",
        "section": "typography"
      }
    ],
    "dos": [
      "Construye jerarquía con escala, peso y espacio antes que con color.",
      "Usa accent-ink para texto ámbar legible.",
      "Separa con filetes de 1px y deja que el espacio haga el resto.",
      "Etiqueta con mono solo lo que es dato: fecha, versión, correo, cifra.",
      "Mantén una sola curva de easing en todo el sitio."
    ],
    "donts": [
      "No pongas kicker ni etiqueta encima de un titular.",
      "No uses accent como color de texto sobre papel.",
      "No introduzcas sombras, halos ni desenfoques decorativos.",
      "No metas tarjetas dentro de tarjetas ni rejillas de contenedores iguales.",
      "No uses border-left de color de más de 1px en tarjetas, filas ni avisos.",
      "No añadas animaciones de entrada por sección."
    ]
  }
